# AnalystOS configuration. Copy to .env and adjust. Every value has a safe local default.

# --- Metadata database (SQLAlchemy URL) -------------------------------------------------
# Local development uses SQLite; docker-compose overrides this with Postgres.
DATABASE_URL=sqlite:///./data/analystos.db
# Postgres example: postgresql+psycopg://analystos:analystos@localhost:5432/analystos

# --- Storage -------------------------------------------------------------------------------
# Workspace DuckDB files, uploads and the demo dataset cache live here.
DATA_DIR=./data

# --- Security ------------------------------------------------------------------------------
# Master secret for session signing and connector-credential encryption (Fernet key derived from it).
# Required when AOS_ENV=production (the API refuses to start without it). Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# In development an unset key is generated once into DATA_DIR/.secret_key.
AOS_SECRET_KEY=
AOS_ENV=development
# AUTH_MODE: password = email + password sign-in (docker-compose default);
#   auto = single-user "Local Analyst" until the first account exists (the development default);
#   local = always single user. The no-password modes only admit requests from this machine
#   (loopback peer and localhost Host), and in production they refuse to start unless
#   AOS_ALLOW_INSECURE_LOCAL=true. Leave AUTH_MODE unset to get each context's default.
# AUTH_MODE=password
# AOS_ALLOW_INSECURE_LOCAL=false
# When set, creating the first account (which owns every existing workspace) requires this token.
# `make docker-env` generates one. Set it whenever the server is reachable from other machines.
AOS_BOOTSTRAP_TOKEN=
# Sign-up is open only while no password account exists; set true to allow open sign-up after that.
# AOS_ALLOW_SIGNUP=false
# Shared secret between the web server's /api proxy and the API. The proxy sends the real browser
# address authenticated with it, so the API can refuse no-password local mode to other machines.
# Set the same value for both processes (`make dev` and `make docker-env` generate one).
AOS_PROXY_SECRET=
# Failed logins per account and per IP before a lockout (seconds, doubling, capped at 900).
AOS_LOGIN_MAX_FAILURES=5
AOS_LOGIN_LOCKOUT_S=30
# Set true behind HTTPS so the session cookie is never sent in clear text.
AOS_COOKIE_SECURE=false
AOS_SESSION_TTL_HOURS=336
AOS_CORS_ORIGINS=["http://localhost:3000"]

# --- AI (optional) -------------------------------------------------------------------------
# AnalystOS works fully without an API key; the deterministic engine does every calculation.
# With a key and AI_ENABLED=true the LLM may be used for the parts described in docs/ai-architecture.md;
# it never produces a number that the engine did not compute.
AI_ENABLED=false
ANTHROPIC_API_KEY=

# --- Limits --------------------------------------------------------------------------------
AOS_MAX_UPLOAD_MB=200
AOS_QUERY_ROW_LIMIT=10000
AOS_QUERY_TIMEOUT_S=30
AOS_PYTHON_TIMEOUT_S=30
AOS_PYTHON_MEM_MB=1024
AOS_ANALYSIS_ROW_LIMIT=100000

# --- Server --------------------------------------------------------------------------------
AOS_HOST=127.0.0.1
AOS_PORT=8000
AOS_LOG_LEVEL=INFO
AOS_LOG_JSON=true
AOS_AUTO_MIGRATE=true

# --- Web -----------------------------------------------------------------------------------
# Where the web server's /api proxy sends requests (read at runtime).
API_URL=http://localhost:8000

# --- docker-compose ------------------------------------------------------------------------
# Host interface the web (3000) and API (8000) ports are published on. Keep 127.0.0.1 unless a
# TLS reverse proxy fronts the stack.
AOS_PUBLISH_HOST=127.0.0.1
POSTGRES_USER=analystos
POSTGRES_PASSWORD=analystos
POSTGRES_DB=analystos
